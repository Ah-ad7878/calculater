<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base application theme. -->
    <style name="Base.Theme.Calculater" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Calculater" parent="Base.Theme.Calculater" />

    <!-- for port layout -->

    <style name="material_button" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">70dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">22sp</item>
        <item name="backgroundTint">@color/grey</item>
        <item name="cornerRadius">40dp</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- Equal Button -->

    <style name="equal" parent="Widget.Material3.Button">
        <item name="android:layout_width">150dp</item>
        <item name="backgroundTint">@color/pink</item>
        <item name="android:layout_height">70dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">22sp</item>
        <item name="elevation">8dp</item>
        <item name="cornerRadius">40dp</item>
    </style>


    <!-- landscape layout -->
    <style name="landscape_button" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">22sp</item>
        <item name="backgroundTint">@color/grey</item>
        <item name="cornerRadius">40dp</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- Theme for Chip -->
    <style name="CustomChipStyle" parent="Widget.Material3.Chip.Assist">
        <item name="android:textColor">@color/black</item>
        <item name="chipBackgroundColor">@color/grey</item>
        <item name="chipStrokeColor">@color/black</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="elevation">6dp</item>
        <item name="shapeAppearance">?attr/shapeAppearanceSmallComponent</item>
        <item name="chipCornerRadius">30dp</item>
    </style>

    <!-- unit measure button -->
    <style name="material_button_unit_measure" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">20sp</item>
        <item name="backgroundTint">@color/grey</item>
        <item name="cornerRadius">36dp</item>
        <item name="elevation">8dp</item>
        <item name="android:shadowRadius">12</item>
    </style>

</resources>