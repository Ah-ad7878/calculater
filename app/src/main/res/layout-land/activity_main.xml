<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray"
    tools:context=".MainActivity">


    <TextView
        android:id="@+id/ed_screen"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/edittext_background"
        android:elevation="8dp"
        android:gravity="end|center_vertical"
        android:hint="0"
        android:inputType="text"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textColor="@color/black"
        android:textColorHint="@color/black"
        android:textSize="32sp"
        app:layout_constraintStart_toStartOf="@+id/guideline2"
        app:layout_constraintTop_toTopOf="@+id/guideline" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/unit_measure"
        android:layout_width="80dp"
        android:layout_height="60dp"
        android:layout_marginStart="628dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/grey"
        android:elevation="8dp"
        app:cornerRadius="40dp"
        app:icon="@drawable/baseline_scale_24"
        app:iconGravity="textStart"
        app:iconSize="22sp"
        app:iconTint="@color/black"
        app:layout_constraintStart_toStartOf="@id/guideline2"
        app:layout_constraintTop_toBottomOf="@id/ed_screen"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/trigno"
        android:layout_width="80dp"
        android:layout_height="60dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/grey"
        android:elevation="8dp"
        app:cornerRadius="40dp"
        app:icon="@drawable/trigonometry"
        app:iconGravity="textStart"
        app:iconSize="22sp"
        app:iconTint="@color/black"
        app:layout_constraintStart_toEndOf="@id/unit_measure"
        app:layout_constraintTop_toBottomOf="@id/ed_screen" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_clear"
        style="@style/material_button"
        android:layout_marginStart="228dp"
        android:layout_marginTop="20dp"
        android:text="clr"
        app:layout_constraintStart_toStartOf="@+id/guideline2"
        app:layout_constraintTop_toBottomOf="@+id/ed_screen" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_del"
        style="@style/material_button"
        android:layout_marginStart="8dp"
        android:layout_marginTop="20dp"
        android:text="del"
        app:layout_constraintStart_toEndOf="@+id/mb_clear"
        app:layout_constraintTop_toBottomOf="@+id/ed_screen" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_modules"
        style="@style/material_button"
        android:layout_marginStart="12dp"
        android:layout_marginTop="20dp"
        android:text="%"
        app:layout_constraintStart_toEndOf="@+id/mb_del"
        app:layout_constraintTop_toBottomOf="@+id/ed_screen" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_divide"
        style="@style/material_button"
        android:layout_marginStart="8dp"
        android:layout_marginTop="20dp"
        android:text="/"
        app:layout_constraintStart_toEndOf="@id/mb_modules"
        app:layout_constraintTop_toBottomOf="@id/ed_screen" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_seven"
        style="@style/material_button"
        android:layout_marginStart="228dp"
        android:layout_marginTop="4dp"
        android:text="7"
        app:layout_constraintStart_toStartOf="@id/guideline2"
        app:layout_constraintTop_toBottomOf="@id/mb_clear" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_eight"
        style="@style/material_button"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:text="8"
        app:layout_constraintStart_toEndOf="@id/mb_seven"
        app:layout_constraintTop_toBottomOf="@id/mb_del" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_nine"
        style="@style/material_button"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:text="9"
        app:layout_constraintStart_toEndOf="@id/mb_eight"
        app:layout_constraintTop_toBottomOf="@id/mb_modules" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_multiply"
        style="@style/material_button"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:text="*"
        app:layout_constraintStart_toEndOf="@id/mb_nine"
        app:layout_constraintTop_toBottomOf="@id/mb_divide" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_four"
        style="@style/material_button"
        android:layout_marginStart="228dp"
        android:layout_marginTop="12dp"
        android:text="4"
        app:layout_constraintStart_toStartOf="@id/guideline2"
        app:layout_constraintTop_toBottomOf="@id/mb_seven" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_five"
        style="@style/material_button"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="5"
        app:layout_constraintStart_toEndOf="@id/mb_four"
        app:layout_constraintTop_toBottomOf="@id/mb_eight" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_six"
        style="@style/material_button"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:text="6"
        app:layout_constraintStart_toEndOf="@id/mb_five"
        app:layout_constraintTop_toBottomOf="@id/mb_nine" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_subtract"
        style="@style/material_button"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="-"
        app:layout_constraintStart_toEndOf="@id/mb_six"
        app:layout_constraintTop_toBottomOf="@id/mb_multiply" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_one"
        style="@style/material_button"
        android:layout_marginStart="228dp"
        android:layout_marginTop="8dp"
        android:text="1"
        app:layout_constraintStart_toStartOf="@id/guideline2"
        app:layout_constraintTop_toBottomOf="@id/mb_four" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_two"
        style="@style/material_button"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="2"
        app:layout_constraintStart_toEndOf="@id/mb_one"
        app:layout_constraintTop_toBottomOf="@id/mb_five" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_three"
        style="@style/material_button"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:text="3"
        app:layout_constraintStart_toEndOf="@id/mb_two"
        app:layout_constraintTop_toBottomOf="@id/mb_six" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_add"
        style="@style/material_button"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="+"
        app:layout_constraintStart_toEndOf="@id/mb_three"
        app:layout_constraintTop_toBottomOf="@id/mb_subtract" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_dot"
        style="@style/material_button"
        android:layout_marginStart="228dp"
        android:layout_marginTop="4dp"
        android:text="."
        app:layout_constraintStart_toStartOf="@id/guideline2"
        app:layout_constraintTop_toBottomOf="@id/mb_one" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_zero"
        style="@style/material_button"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="0"
        app:layout_constraintStart_toEndOf="@id/mb_dot"
        app:layout_constraintTop_toBottomOf="@id/mb_two" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_equal"
        style="@style/material_button"
        android:layout_width="150dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="8dp"
        android:text="="
        app:backgroundTint="@color/pink"
        app:layout_constraintStart_toEndOf="@id/mb_zero"
        app:layout_constraintTop_toBottomOf="@id/mb_three" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.02" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.0" />
</androidx.constraintlayout.widget.ConstraintLayout>