<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="16dp"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.00" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.35" />

    <!-- Left Side: Display Screen -->
    <TextView
        android:id="@+id/ed_screen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/edittext_background"
        android:elevation="4dp"
        android:gravity="end|center_vertical"
        android:hint="@string/zero"
        android:inputType="text"
        android:maxLength="50"
        android:maxLines="1"
        android:scrollHorizontally="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/unit_measure"
        app:layout_constraintEnd_toStartOf="@id/guideline2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Utility Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/unit_measure"
        style="@style/material_button_unit_measure"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginEnd="16dp"
        android:text="@string/unit_converter"
        app:icon="@drawable/baseline_scale_24"
        app:iconGravity="textStart"
        app:iconSize="18dp"
        app:iconTint="@color/secondary_accent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/trigno"
        style="@style/material_button_unit_measure"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:padding="0dp"
        app:icon="@drawable/trigonometry"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="20dp"
        app:iconTint="@color/secondary_accent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/unit_measure" />

    <!-- Right Side Keypad Grid -->
    <!-- Row 1 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_clear"
        style="@style/material_button_clear"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="4dp"
        android:text="@string/clr"
        app:layout_constraintBottom_toTopOf="@id/mb_seven"
        app:layout_constraintEnd_toStartOf="@id/mb_del"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/guideline2"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_del"
        style="@style/material_button_clear"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:text="@string/del"
        app:layout_constraintBottom_toTopOf="@id/mb_eight"
        app:layout_constraintEnd_toStartOf="@id/mb_modules"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/mb_clear"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_modules"
        style="@style/material_button_operator"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:text="@string/module"
        app:layout_constraintBottom_toTopOf="@id/mb_nine"
        app:layout_constraintEnd_toStartOf="@id/mb_divide"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/mb_del"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_divide"
        style="@style/material_button_operator"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:text="@string/divide"
        app:layout_constraintBottom_toTopOf="@id/mb_multiply"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/mb_modules"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Row 2 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_seven"
        style="@style/material_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:text="@string/seven"
        app:layout_constraintBottom_toTopOf="@id/mb_four"
        app:layout_constraintEnd_toStartOf="@id/mb_eight"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/guideline2"
        app:layout_constraintTop_toBottomOf="@id/mb_clear" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_eight"
        style="@style/material_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:text="@string/Eight"
        app:layout_constraintBottom_toTopOf="@id/mb_five"
        app:layout_constraintEnd_toStartOf="@id/mb_nine"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/mb_seven"
        app:layout_constraintTop_toBottomOf="@id/mb_del" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_nine"
        style="@style/material_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:text="@string/Nine"
        app:layout_constraintBottom_toTopOf="@id/mb_six"
        app:layout_constraintEnd_toStartOf="@id/mb_multiply"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/mb_eight"
        app:layout_constraintTop_toBottomOf="@id/mb_modules" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_multiply"
        style="@style/material_button_operator"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:text="@string/multiply"
        app:layout_constraintBottom_toTopOf="@id/mb_subtract"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/mb_nine"
        app:layout_constraintTop_toBottomOf="@id/mb_divide" />

    <!-- Row 3 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_four"
        style="@style/material_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:text="@string/four"
        app:layout_constraintBottom_toTopOf="@id/mb_one"
        app:layout_constraintEnd_toStartOf="@id/mb_five"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/guideline2"
        app:layout_constraintTop_toBottomOf="@id/mb_seven" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_five"
        style="@style/material_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:text="@string/five"
        app:layout_constraintBottom_toTopOf="@id/mb_two"
        app:layout_constraintEnd_toStartOf="@id/mb_six"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/mb_four"
        app:layout_constraintTop_toBottomOf="@id/mb_eight" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_six"
        style="@style/material_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:text="@string/six"
        app:layout_constraintBottom_toTopOf="@id/mb_three"
        app:layout_constraintEnd_toStartOf="@id/mb_subtract"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/mb_five"
        app:layout_constraintTop_toBottomOf="@id/mb_nine" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_subtract"
        style="@style/material_button_operator"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:text="@string/subtract"
        app:layout_constraintBottom_toTopOf="@id/mb_add"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/mb_six"
        app:layout_constraintTop_toBottomOf="@id/mb_multiply" />

    <!-- Row 4 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_one"
        style="@style/material_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:text="@string/one"
        app:layout_constraintBottom_toTopOf="@id/mb_dot"
        app:layout_constraintEnd_toStartOf="@id/mb_two"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/guideline2"
        app:layout_constraintTop_toBottomOf="@id/mb_four" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_two"
        style="@style/material_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:text="@string/Two"
        app:layout_constraintBottom_toTopOf="@id/mb_zero"
        app:layout_constraintEnd_toStartOf="@id/mb_three"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/mb_one"
        app:layout_constraintTop_toBottomOf="@id/mb_five" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_three"
        style="@style/material_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:text="@string/Three"
        app:layout_constraintBottom_toTopOf="@id/mb_equal"
        app:layout_constraintEnd_toStartOf="@id/mb_add"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/mb_two"
        app:layout_constraintTop_toBottomOf="@id/mb_six" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_add"
        style="@style/material_button_operator"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:text="@string/Add"
        app:layout_constraintBottom_toTopOf="@id/mb_equal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/mb_three"
        app:layout_constraintTop_toBottomOf="@id/mb_subtract" />

    <!-- Row 5 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_dot"
        style="@style/material_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:text="@string/Dot"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/mb_zero"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/guideline2"
        app:layout_constraintTop_toBottomOf="@id/mb_one" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_zero"
        style="@style/material_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:text="@string/Zero"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/mb_equal"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/mb_dot"
        app:layout_constraintTop_toBottomOf="@id/mb_two" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_equal"
        style="@style/equal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:text="@string/Equal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintStart_toEndOf="@id/mb_zero"
        app:layout_constraintTop_toBottomOf="@id/mb_three" />

</androidx.constraintlayout.widget.ConstraintLayout>
